# Pick one brain. Leave both unset to run on the free mock brain.

# --brain openrouter  (your own key; same prompts, sent through OpenRouter)
OPENROUTER_API_KEY=
# Separate funded pool for hosted subscribers. Never reuse the public-world key.
# Required in production before enabling hosted subscriptions with OpenRouter.
OPENROUTER_SUBSCRIBER_API_KEY=
UW_OR_MODEL_ROUTINE=anthropic/claude-haiku-4.5
UW_OR_MODEL_STAKES=anthropic/claude-sonnet-5
UW_OR_MODEL_REFLECT=anthropic/claude-opus-5

# --brain anthropic  (direct)
ANTHROPIC_API_KEY=
UW_MODEL_ROUTINE=claude-haiku-4-5
UW_MODEL_STAKES=claude-sonnet-5
UW_MODEL_REFLECT=claude-opus-5

# Server
PORT=4000
UW_BRAIN=mock              # mock | openrouter | anthropic
UW_MS_PER_SIM_MINUTE=1000  # 60000 is real time
UW_CITIZENS=10
UW_SEED=42

# Supabase (server writes with the service role; the web app uses the publishable key)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # Dashboard → Settings → API. Only the server needs it; never ship it to a browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:4000
UW_DEV_OWNER=0   # 1 lets a plain name sign in, for local development only
NEXT_PUBLIC_DEV_OWNER=0

# Stripe (optional). Without these the server runs billing in test mode: packs and plans apply with no charge.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: price ids override the lookup keys made by scripts/stripe-setup.mjs (unwatched_resident_monthly, unwatched_patron_monthly)
STRIPE_PRICE_RESIDENT=
STRIPE_PRICE_PATRON=
# A Patron's careful thoughts go to this model (default Opus 5); everyone else's to UW_OR_MODEL_STAKES
UW_OR_MODEL_PATRON_STAKES=

# Ops room. Anyone with this token can pause the island; keep it out of browsers you do not own.
UW_OPS_TOKEN=
# Soft model downgrade threshold only: this DOES NOT stop spending. Metrics reset
# on process restart and count simulation days. Set a hard limit on the provider
# API key before enabling paid models; do not use this as a billing safeguard.
UW_DAILY_CEILING_USD=120

# Which island this server runs. Use a different id locally so a dev server never shares a record with the deployed town.
UW_TOWN_ID=island

# Music and voices. Optional: an AI Studio key. scripts/gen-music.mjs writes a Lyria bed per scene into apps/web/public/sound,
# and the server reads letters aloud with Gemini text-to-speech (one voice per citizen, each reading made once and kept under out/town/voices).
GEMINI_API_KEY=
# UW_TTS_MODEL=gemini-2.5-flash-preview-tts

# Drawings. Optional: a Recraft API key (recraft.ai). When a citizen builds and says how it should look, the island asks Recraft's
# vector model for an SVG in its own palette, disciplines it, and keeps it under out/town/looks/<town>/<hash>.svg and in the record.
# Without a key, a drawing dropped into that folder by hand shows just the same.
RECRAFT_API_KEY=
# UW_LOOK_MODEL=recraftv4_1_vector
# UW_LOOKS=patterns   # open the pattern book (apps/server/patterns) for described builds even without a key; off by default, the drawn set is the look

# Islands that connect. Other islands a boat runs to, as id=engine-url pairs, and the secret every linked island shares.
# A citizen who leaves for one arrives there with their coins, things and memories; the news from home crosses with them.
UW_TOWN_NAME=The island
UW_HARBORS=
UW_BOAT_SECRET=

# The island keeps our time. Set to hvar, vis or korcula: the weather is that island's live weather from Open-Meteo (no key),
# the seasons are the calendar's, the clock is that island's clock, dawn and dusk are its sunrise and sunset, and the boat keeps a seasonal timetable.
UW_REAL_WORLD=43.17,16.44,Europe/Zagreb
# UW_REAL_WORLD_NAME=the coast   # what the island calls the place whose sky it keeps

# The island's own address. The web build talks to the engine here; leave unset to use the platform's hostname.
UW_PUBLIC_URL=https://unwatched.world

# The morning mail. Optional: a Resend key (resend.com). At seven each island morning owners get their citizen's written digest,
# and a note when their citizen writes home. Without the key nothing is sent and the log says so.
RESEND_API_KEY=
MAIL_FROM=Unwatched <noreply@unwatched.world>

# Shared Telegram bot. User chat/agent selections are stored in owner_telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Optional dedicated key for explicitly authorized live audits; use a non-resetting provider cap.
UW_AUDIT_OPENROUTER_API_KEY=
